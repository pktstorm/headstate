# `yarn tauri icon` (run via `make icons`) generates Windows/iOS/Android
# icon variants that this macOS-only app never uses. The Makefile prunes
# them, but ignore them too as a backstop in case that step is skipped.
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/icons/icon.ico
src-tauri/icons/StoreLogo.png
src-tauri/icons/Square*.png
src-tauri/icons/64x64.png
